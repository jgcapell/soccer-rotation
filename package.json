{
  "name": "soccer-rotation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Roster and fair playing-time rotation for a toddler soccer team",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create soccer-rotation",
    "db:init": "wrangler d1 execute soccer-rotation --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute soccer-rotation --local --file=schema.sql",
    "test": "node test/rotation.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
